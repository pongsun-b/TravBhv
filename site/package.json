{
  "name": "tbrg-lab-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TBRG, the Travel Behavior Research Group. Identity system and website, built with SvelteKit.",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build && node scripts/fix-fallback-paths.mjs",
    "preview": "vite preview",
    "serve": "node server/inquiries.mjs",
    "brand": "node scripts/build-brand.mjs && node scripts/build-assets.mjs",
    "tokens": "node scripts/tokens-export.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "verify:repo": "node scripts/check-repo-hygiene.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "axe-core": "^4.13.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
